{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "pdf-finder",
    "main": "worker/index.ts",
    "compatibility_date": "2026-09-20",
    /*
     * The public hostname, and the only one.
     *
     * `workers_dev: false` matters as much as the route: left at its default the Worker is also
     * reachable at `pdf-finder.<account>.workers.dev`, which is a second public origin nobody
     * announced, outside the zone's WAF and analytics, and not the origin the same-origin check in
     * §9.1 was reasoned about.
     *
     * `kourin.jp` must already be a zone on the account; `custom_domain` makes Cloudflare create
     * and manage the DNS record and the certificate for the subdomain.
     */
    "routes": [{ "pattern": "pdf-finder.kourin.jp", "custom_domain": true }],
    "workers_dev": false,
    // Serves the built client and the Worker from one origin, which is what spec §9.1 requires.
    "assets": {
        "directory": "./dist/client",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
    },
    // Per-client admission, checked before the request body is read (spec §9.3). Per-colo rather
    // than global: it bounds one client, not the provider account. SEARCH_BUDGET does that.
    //
    // 20 a minute is set from what a reader does, not from what the provider can carry: refining a
    // query a few times in quick succession is ordinary, and a limit a person can reach by using
    // the product is a defect. It still bounds one client to a third of the provider's published
    // request rate on its own. The first value tried was 6, which the evaluation harness — 32
    // queries, one after another — hit on its seventh query.
    "ratelimits": [
        {
            "name": "SEARCH_RATE_LIMIT",
            "namespace_id": "1001",
            "simple": { "limit": 20, "period": 60 },
        },
    ],
    // The account-wide provider budget. One instance, holding counters and expiring reservations
    // only — never a query, a passage, or a document identifier (spec §10).
    "durable_objects": {
        "bindings": [{ "name": "SEARCH_BUDGET", "class_name": "SearchBudget" }],
    },
    "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SearchBudget"] }],
    // Declared rather than assumed. A search at the segment cap issues 500 provider calls in one
    // invocation and, with the one retry §6.4 allows, up to 1,000; see
    // `LIMITS.declaredSubrequestAllowance`. This key is honoured only on the standard usage model,
    // so a Free-plan deploy fails here instead of failing at a reader's fiftieth subrequest.
    "limits": { "cpu_ms": 30000, "subrequests": 1100 },
    "observability": {
        "enabled": true,
        "traces": {
            "enabled": true,
        },
    },
}
