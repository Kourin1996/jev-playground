# Response headers for the static assets Cloudflare serves without invoking the Worker.
#
# `wrangler.jsonc` does not set `run_worker_first`, so the asset router answers /index.html and
# /assets/* directly; worker/http/security-headers.ts covers only the single-page-application
# fallback and anything the Worker serves itself. The two sets must stay identical, and
# `tests/headers.spec.ts` checks that they do.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://challenges.cloudflare.com; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' blob: data:; connect-src 'self'; frame-src https://challenges.cloudflare.com; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
