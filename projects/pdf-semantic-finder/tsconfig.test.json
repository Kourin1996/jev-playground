{
    "compilerOptions": {
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
        "target": "ES2023",
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "types": ["node", "vite/client"],
        "skipLibCheck": true,
        "isolatedModules": true,
        "moduleDetection": "force",
        "noEmit": true,
        // `npm run eval` runs under Node's type stripping, which needs the explicit `.ts` extension.
        "allowImportingTsExtensions": true,
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "baseUrl": ".",
        "paths": {
            "@/*": ["./src/*"]
        }
    },
    "include": [
        "tests",
        "worker/admission/budget.ts",
        "worker/admission/estimate-tokens.ts",
        "worker/http",
        "worker/search",
        "src/lib/types.ts",
        "playwright.config.ts",
        "vite.config.ts"
    ]
}
